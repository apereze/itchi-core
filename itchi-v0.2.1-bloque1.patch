+    """
+    spec: dict[str, Any] = {
+        "kind": "class_table",
+        "axes": {str(k): tuple(str(n) for n in v) for k, v in table_cfg["axes"].items()},
+    }
+    if "table" in table_cfg:
+        spec["table"] = table_cfg["table"]
+    else:
+        spec["p6_values"] = tuple(float(v) for v in table_cfg["p6_values"])
+        spec["rules"] = tuple(
