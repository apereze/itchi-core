configs/local.yaml
configs/paths.local.yaml
*.secret.yaml
*.secrets.yaml


# ============================================================
# Raw and intermediate data
# ============================================================
# Data folders are kept in the repository only through .gitkeep.
# Actual data files should not be committed.

data/raw/*
data/interim/*
data/processed/*
data/external/*

!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep


# ============================================================
# Outputs
# ============================================================
# Outputs are generated locally and should not be committed.

outputs/climatology/*
outputs/itchi_gridded/*
outputs/event_products/*
outputs/diagnostics/*
outputs/figures/*

!outputs/climatology/.gitkeep
!outputs/itchi_gridded/.gitkeep
!outputs/event_products/.gitkeep
!outputs/diagnostics/.gitkeep
!outputs/figures/.gitkeep


