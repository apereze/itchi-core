+            frac = np.array([100 * np.mean(b1.siat_class(por_par.loc[mask, f"ITCHI|{p}|{w}"].to_numpy(float)) == c)
+                             for p, w in configs])
+            ax.bar(range(len(configs)), frac, bottom=bottom, color=SIAT_COLORS[c], label=f"clase {c}",
