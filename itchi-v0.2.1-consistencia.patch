+    precipitation_nan_value : float or None, default=0.0
+        H_P where it is NaN (missing P6 or 6-h percentile); None keeps NaN.
+        The cells are reported in "H_P_missing".
+    wind_tail_h34 : float, default=0.2
+        Wind hazard at the 34-kt radius.
+    wind_tail_end_kt : float or None, default=None
+        Optional cut of the tail at a wind speed (kt, < 34); the tail never
+        extends beyond R_W06_q.
+    r34_mean_km : float or None, default=None
+        Observed mean R34 (km) to calibrate W06; None takes the mean of the
+        valid observed quadrants (no calibration if there are none).
+    w06_profile_kwargs : Mapping or None, default=None
+        Extra arguments for the wind profile (Willoughby2006Profile).
+    alpha_wind, beta_precip_direct, lambda_direct, mu_indirect : float
+        ITCHI weights (default 1.0).
+    run_quality_control : bool, default=False
+        Run the snapshot quality-control checks.
+
+    Returns
+    -------
+    dict[str, Any]
+        Fields: radius_km, quadrant, R_direct_q, R_attr_q, R_W06_q, M_direct,
+        M_indirect, M_exterior, H_P, H_P_missing, H_Pdir, H_Pind, H_W,
+        H_Wdir, H_Wind, H_dir, H_ind, ITCHI, wind_kt. Metadata: radii by
+        quadrant and their sources, attribution status by quadrant, W06
+        parameters, itchi_version and itchi_formulation = "v0.2".
+    """
+    vmax = _positive_or_none(vmax_kt)
+    if vmax is None:
+        raise ValueError(f"vmax_kt must be finite and > 0. Received: {vmax_kt}")
+
+    # 1. Precipitation matrix
+    matrix = PRECIP_MATRIX_V02 if precip_matrix is None else precip_matrix
+    hazard_precip = compute_precipitation_matrix_hazard(
+        precipitation=p6,
+        quantiles_6h=quantiles_6h,
+        escalation_values={"R24": r24, "A72": a72},
+        escalation_quantiles={"R24": quantiles_24h, "A72": quantiles_72h},
+        matrix=matrix,
+    )
+    precip_missing = _missing(hazard_precip)
+    if precipitation_nan_value is not None:
+        hazard_precip = _fill_missing(hazard_precip, float(precipitation_nan_value))
+
+    # 2. Direct radius and W06 reference radii
+    rmw_observed = _positive_or_none(rmw_km)
+    r34_km = convert_quadrant_radii_to_km(radii_by_quadrant=r34_by_quadrant, input_unit=r34_unit)
+    if r34_mean_km is None:
+        r34_mean_km = _mean_positive(r34_km)
+
+    w06_settings = {**R_W06_DEFAULTS, **dict(r_w06_kwargs or {})}
+    reference = compute_w06_reference_radii(
+        vmax_kt=vmax,
+        lat=float(center_lat),
+        rmw_km=rmw_observed,
+        r34_mean_km=r34_mean_km,
+        **w06_settings,
+    )
+
+    fallback = fallback_direct_radius_km
+    if fallback is None and w06_direct_fallback and np.isfinite(reference["r34_km"]):
+        fallback = reference["r34_km"]
+
+    rmw_for_direct = rmw_observed
+    if rmw_for_direct is None and np.isfinite(reference["rmax_km"]):
+        rmw_for_direct = reference["rmax_km"]
+
+    resolved_direct = resolve_direct_radius(
+        r34_by_quadrant=r34_km,
+        vmax_kt=vmax,
+        rmw_km=rmw_for_direct,
+        fallback_radius_km=fallback,
+        fill_strategy=radius_fill_strategy,
+    )
+    direct_radii = resolved_direct.radii
+
+    # 3. R_W06 by quadrant, never below R_direct_q
+    if r_w06_km is None:
+        if not np.isfinite(reference["r_outer_km"]):
+            raise ValueError("R_W06 is undefined for this record (check vmax_kt and the threshold).")
+        r_w06_raw = {q: reference["r_outer_km"] for q in QUADRANTS}
+        r_w06_source = "w06_parametric"
+    else:
+        if isinstance(r_w06_km, Mapping):
+            r_w06_raw = standardize_quadrant_radii(dict(r_w06_km))
+        else:
+            r_w06_raw = {q: float(r_w06_km) for q in QUADRANTS}
+        r_w06_source = "provided"
+
+    invalid = [q for q in QUADRANTS if _positive_or_none(r_w06_raw[q]) is None]
+    if invalid:
+        raise ValueError(f"R_W06 must be finite and > 0 in quadrant(s): {', '.join(invalid)}")
+
+    r_w06 = {q: max(float(r_w06_raw[q]), float(direct_radii[q])) for q in QUADRANTS}
+    r_w06_clipped = tuple(q for q in QUADRANTS if float(r_w06_raw[q]) < float(direct_radii[q]))
+
+    # 4. Attribution radius: ROCLOUD with R_W06 floor
+    rocloud_km = None
+    if rocloud_by_quadrant is not None:
+        rocloud_km = convert_quadrant_radii_to_km(
+            radii_by_quadrant=rocloud_by_quadrant,
+            input_unit=rocloud_unit,
+        )
+
+    attribution = resolve_attribution_radius_with_w06(
+        rocloud_by_quadrant=rocloud_km,
+        r_w06_by_quadrant=r_w06,
+        direct_by_quadrant=direct_radii,
+        mode=w06_attribution_mode,
+        fill_strategy=radius_fill_strategy,
+    )
+
+    # Geometry and per-cell radii
+    geometry = build_geometry_fields(lon=lon, lat=lat, center_lon=center_lon, center_lat=center_lat)
+    radius_km = geometry["radius_km"]
+    quadrant = geometry["quadrant"]
+
+    direct_q = assign_quadrant_radius(quadrant=quadrant, radii_by_quadrant=direct_radii)
+    attribution_q = assign_quadrant_radius(quadrant=quadrant, radii_by_quadrant=attribution.radii)
+    r_w06_q = assign_quadrant_radius(quadrant=quadrant, radii_by_quadrant=r_w06)
+
+    # 5. W06 wind with a tail that ends at R_W06
+    wind = compute_w06_wind_hazard_with_tail(
+        radius_km=radius_km,
+        direct_radius_km=direct_q,
+        attribution_radius_km=r_w06_q,
+        vmax_kt=vmax,
+        lat=float(center_lat),
+        rmw_km=rmw_observed,
+        r34_mean_km=r34_mean_km,
+        h34=wind_tail_h34,
+        tail_end_wind_kt=wind_tail_end_kt,
+        **dict(w06_profile_kwargs or {}),
+    )
+
+    # 6. Masks, components and ITCHI
+    core = compute_itchi_snapshot(
+        precipitation=p6,
+        q90=None,
+        q95=None,
+        q99=None,
+        radius_km=radius_km,
+        r34_km=direct_q,
+        rocloud_km=attribution_q,
+        wind_hazard_normalized=wind["H_W"],
+        alpha_wind=alpha_wind,
+        beta_precip_direct=beta_precip_direct,
+        lambda_direct=lambda_direct,
+        mu_indirect=mu_indirect,
+        run_quality_control=False,
+        precipitation_hazard=hazard_precip,
+        wind_hazard_indirect=wind["H_W"],
+    )
+
+    result: dict[str, Any] = {
+        "radius_km": radius_km,
+        "quadrant": quadrant,
+        "R_direct_q": direct_q,
+        "R_attr_q": attribution_q,
+        "R_W06_q": r_w06_q,
+        **core,
+        "H_P_missing": precip_missing,
+        "wind_kt": wind["wind_kt"],
+        # radii metadata (km, by quadrant)
+        "R_direct_by_quadrant": dict(direct_radii),
+        "R_direct_source": resolved_direct.source,
+        "R_direct_filled_quadrants": resolved_direct.filled_quadrants,
+        "R_direct_used_fallback": resolved_direct.used_fallback,
+        "R_W06_by_quadrant": r_w06,
+        "R_W06_source": r_w06_source,
+        "R_W06_clipped_to_direct": r_w06_clipped,
+        "R_attr_by_quadrant": attribution.radii,
+        "R_attr_status": attribution.status,
+        "R_attr_clipped_to_direct": attribution.clipped_to_direct,
+        "w06_attribution_mode": attribution.mode,
+        # wind and precipitation metadata
+        "wind_hazard_source": "w06_tail",
+        "w06_x1_km": wind["x1_km"],
+        "w06_x1_calibrated": wind["x1_calibrated"],
+        "wind_tail_h34": float(wind_tail_h34),
+        "wind_tail_end_kt": wind_tail_end_kt,
+        "precipitation_hazard_source": "matrix_v02",
+        "itchi_version": ITCHI_VERSION,
+        "itchi_formulation": "v0.2",
+    }
+
+    if run_quality_control:
+        # run_snapshot_quality_control checks R_direct_q <= ROCLOUD_q
+        run_snapshot_quality_control({**result, "ROCLOUD_q": attribution_q})
+
+    return result
diff --git a/src/itchi/radii.py b/src/itchi/radii.py
index 832ade3..aa0b52f 100644
--- a/src/itchi/radii.py
+++ b/src/itchi/radii.py
@@ -335,3 +335,149 @@ def resolve_attribution_radius(
         radii_by_quadrant=rocloud_by_quadrant,
         strategy=fill_strategy,
     )
+
+
+# ============================================================
+# ITCHI v0.2: attribution radius with the W06 outer radius
+# ============================================================
+
+W06_ATTRIBUTION_MODES: tuple[str, ...] = ("never", "fallback", "floor", "always")
+
+
+@dataclass(frozen=True)
+class AttributionRadii:
+    """
+    Attribution radius by quadrant and how each quadrant was resolved.
+
+    Attributes
+    ----------
+    radii : dict[str, float]
+        Final attribution radius R_attr_q (km), keys RNE, RSE, RSW, RNW.
+    status : dict[str, str]
+        Rule applied in each quadrant: "rocloud", "rocloud_filled" (mean of the
+        valid ROCLOUD quadrants), "w06_missing_rocloud", "w06_floor" or "w06".
+    clipped_to_direct : tuple[str, ...]
+        Quadrants raised to R_direct_q because the resolved radius was smaller.
+    mode : str
+        W06 attribution mode used.
+    """
+
+    radii: dict[str, float]
+    status: dict[str, str]
+    clipped_to_direct: tuple[str, ...]
+    mode: str
+
+
+def _rocloud_value(value: Any) -> float:
+    """
+    ROCLOUD radius in km or NaN; 0 and negative values mean no detection.
+    """
+    value = _clean_radius_value(value)
+    return value if np.isfinite(value) and value > 0.0 else np.nan
+
+
+def resolve_attribution_radius_with_w06(
+    rocloud_by_quadrant: dict[str, Any] | None,
+    r_w06_by_quadrant: dict[str, Any],
+    direct_by_quadrant: dict[str, Any] | None = None,
+    mode: str = "floor",
+    fill_strategy: str = "mean_available",
+) -> AttributionRadii:
+    """
+    Resolve the attribution radius R_attr_q from ROCLOUD and the W06 outer radius.
+
+    Rules by quadrant (ROCLOUD <= 0 or missing = no detection):
+
+    - "never":    ROCLOUD_q; missing quadrants filled with the mean of the
+                  valid ones (v0.1, ``resolve_attribution_radius``).
+    - "fallback": R_W06_q where ROCLOUD_q is missing, otherwise ROCLOUD_q.
+    - "floor":    R_W06_q where ROCLOUD_q is missing or smaller than R_W06_q,
+                  otherwise ROCLOUD_q (ITCHI v0.2 default).
+    - "always":   R_W06_q.
+
+    In every mode the result is raised to R_direct_q where it is smaller, so
+    that R_direct_q <= R_attr_q.
+
+    Parameters
+    ----------
+    rocloud_by_quadrant : dict[str, Any] or None
+        ROCLOUD radii by quadrant in km; None means no ROCLOUD record.
+    r_w06_by_quadrant : dict[str, Any]
+        W06 outer radius by quadrant in km (all quadrants finite and > 0
+        unless mode == "never").
+    direct_by_quadrant : dict[str, Any] or None, default=None
+        R_direct_q in km; None skips the lower bound.
+    mode : {"never", "fallback", "floor", "always"}, default="floor"
+        Role of R_W06.
+    fill_strategy : str, default="mean_available"
+        Filling strategy for mode="never".
+
+    Returns
+    -------
+    AttributionRadii
+        Final radii, status by quadrant and clipped quadrants.
+
+    Raises
+    ------
+    ValueError
+        If the mode is unknown, R_W06 is invalid where it is needed, or
+        mode="never" has no valid ROCLOUD quadrant.
+    """
+    if mode not in W06_ATTRIBUTION_MODES:
+        raise ValueError(f"Unsupported W06 attribution mode: {mode!r}")
+
+    if rocloud_by_quadrant is None:
+        rocloud = {q: np.nan for q in QUADRANTS}
+    else:
+        rocloud = {
+            q: _rocloud_value(v)
+            for q, v in standardize_quadrant_radii(rocloud_by_quadrant).items()
+        }
+
+    radii: dict[str, float] = {}
+    status: dict[str, str] = {}
+
+    if mode == "never":
+        valid = {q: v for q, v in rocloud.items() if np.isfinite(v)}
+        if not valid:
+            raise ValueError("mode='never' requires at least one valid ROCLOUD quadrant.")
+        filled = fill_missing_quadrant_radii(
+            {q: (v if np.isfinite(v) else None) for q, v in rocloud.items()},
+            strategy=fill_strategy,
+        )
+        radii = dict(filled.radii)
+        status = {
+            q: ("rocloud_filled" if q in filled.filled_quadrants else "rocloud")
+            for q in QUADRANTS
+        }
+    else:
+        r_w06 = standardize_quadrant_radii(r_w06_by_quadrant)
+        bad = [q for q in QUADRANTS if not (np.isfinite(r_w06[q]) and r_w06[q] > 0.0)]
+        if bad:
+            raise ValueError(f"R_W06 must be finite and > 0 in quadrant(s): {', '.join(bad)}")
+
+        for q in QUADRANTS:
+            roc, w06 = rocloud[q], float(r_w06[q])
+            if mode == "always":
+                radii[q], status[q] = w06, "w06"
+            elif not np.isfinite(roc):
+                radii[q], status[q] = w06, "w06_missing_rocloud"
+            elif mode == "floor" and roc < w06:
+                radii[q], status[q] = w06, "w06_floor"
+            else:
+                radii[q], status[q] = float(roc), "rocloud"
+
+    clipped: list[str] = []
+    if direct_by_quadrant is not None:
+        direct = standardize_quadrant_radii(direct_by_quadrant)
+        for q in QUADRANTS:
+            if np.isfinite(direct[q]) and radii[q] < direct[q]:
+                radii[q] = float(direct[q])
+                clipped.append(q)
+
+    return AttributionRadii(
+        radii={q: float(radii[q]) for q in QUADRANTS},
+        status=status,
+        clipped_to_direct=tuple(clipped),
+        mode=mode,
+    )
diff --git a/tests/test_v02_snapshot.py b/tests/test_v02_snapshot.py
new file mode 100644
index 0000000..4dd3830
--- /dev/null
+++ b/tests/test_v02_snapshot.py
@@ -0,0 +1,261 @@
+"""
+Tests for the ITCHI v0.2 entry point (pipeline.compute_itchi_snapshot_v02),
+the attribution radius ROCLOUD with R_W06 floor, the R_W06 definition, the
+optional cut of the wind tail and the consistency between configs/default.yaml
+and the v0.2 defaults.
+"""
+
+from __future__ import annotations
+
+import inspect
+
+import numpy as np
+import pytest
+import xarray as xr
+
+from itchi.climatology import quantile_dataarray_to_dict
+from itchi.config import itchi_v02_settings_from_config, load_default_config
+from itchi.parametric_radii import (
+    R_W06_DEFAULTS,
+    compute_parametric_radii,
+    compute_w06_reference_radii,
+    compute_w06_wind_hazard_with_tail,
+)
+from itchi.pipeline import compute_itchi_snapshot_from_grid, compute_itchi_snapshot_v02
+from itchi.precipitation import PRECIP_MATRIX_V02, compute_precipitation_matrix_hazard
+from itchi.radii import resolve_attribution_radius_with_w06
+
+QUADS = ("RNE", "RSE", "RSW", "RNW")
+Q6 = {"Q75": 8.0, "Q90": 18.0, "Q95": 28.0, "Q99": 50.0}
+Q24 = {"Q90": 40.0, "Q95": 55.0}
+Q72 = {"Q75": 30.0, "Q90": 60.0, "Q95": 80.0}
+
+CASE = dict(
+    center_lon=-95.0, center_lat=20.0, vmax_kt=95.0, rmw_km=30.0,
+    r34_by_quadrant={"RNE": 120, "RSE": 100, "RSW": 60, "RNW": 80}, r34_unit="nm",
+)
+
+
+def _grid() -> tuple[np.ndarray, np.ndarray]:
+    # +-15 degrees around the center: contains R_W06 in every quadrant
+    return np.meshgrid(np.arange(-110.0, -80.0, 0.2), np.arange(5.0, 35.0, 0.2))
+
+
+def _fields(shape: tuple[int, ...], seed: int = 0) -> tuple[np.ndarray, ...]:
+    rng = np.random.default_rng(seed)
+    p6 = rng.gamma(0.7, 12.0, shape)
+    r24 = p6 + rng.gamma(0.7, 25.0, shape)
+    a72 = rng.gamma(0.8, 30.0, shape)
+    return p6, r24, a72
+
+
+def _v02(p6, r24, a72, lon, lat, **kw) -> dict:
+    return compute_itchi_snapshot_v02(
+        p6, r24, a72, quantiles_6h=Q6, quantiles_24h=Q24, quantiles_72h=Q72,
+        lon=lon, lat=lat, **{**CASE, **kw},
+    )
+
+
+def _r_w06() -> float:
+    return compute_w06_reference_radii(CASE["vmax_kt"], CASE["center_lat"])["r_outer_km"]
+
+
+# ------------------------------------------------------------------ radio de atribución
+
+W06 = {q: 700.0 for q in QUADS}
+DIRECT = {"RNE": 200.0, "RSE": 180.0, "RSW": 120.0, "RNW": 150.0}
+
+
+def test_attribution_floor_by_quadrant() -> None:
+    out = resolve_attribution_radius_with_w06(
+        {"RNE": 800.0, "RSE": None, "RSW": 300.0, "RNW": 0.0}, W06, DIRECT
+    )
+    assert out.radii == {"RNE": 800.0, "RSE": 700.0, "RSW": 700.0, "RNW": 700.0}
+    assert out.status == {
+        "RNE": "rocloud", "RSE": "w06_missing_rocloud",
+        "RSW": "w06_floor", "RNW": "w06_missing_rocloud",   # 0 = no detection
+    }
+    assert out.clipped_to_direct == () and out.mode == "floor"
+
+
+def test_attribution_other_modes() -> None:
+    roc = {"RNE": 800.0, "RSE": None, "RSW": 300.0, "RNW": 500.0}
+    fallback = resolve_attribution_radius_with_w06(roc, W06, mode="fallback")
+    assert fallback.radii == {"RNE": 800.0, "RSE": 700.0, "RSW": 300.0, "RNW": 500.0}
+    always = resolve_attribution_radius_with_w06(roc, W06, mode="always")
+    assert set(always.radii.values()) == {700.0}
+    never = resolve_attribution_radius_with_w06(roc, W06, mode="never")
+    assert never.radii["RSE"] == pytest.approx((800.0 + 300.0 + 500.0) / 3.0)
+    assert never.status["RSE"] == "rocloud_filled"
+    with pytest.raises(ValueError):
+        resolve_attribution_radius_with_w06(None, W06, mode="never")
+    with pytest.raises(ValueError):
+        resolve_attribution_radius_with_w06(roc, W06, mode="unknown")
+    with pytest.raises(ValueError):
+        resolve_attribution_radius_with_w06(roc, {**W06, "RNE": np.nan})
+
+
+def test_attribution_never_below_direct() -> None:
+    out = resolve_attribution_radius_with_w06(None, {q: 100.0 for q in QUADS}, DIRECT)
+    assert out.radii == DIRECT
+    assert set(out.clipped_to_direct) == set(QUADS)
+
+
+# ------------------------------------------------------------------ R_W06 y cola de viento
+
+
+def test_r_w06_reference_is_pa21_outer_radius() -> None:
+    ref = compute_w06_reference_radii(90.0, 20.0, rmw_km=30.0, r34_mean_km=200.0)
+    pa21 = compute_parametric_radii(np.array([90.0]), np.array([20.0]), rmax_variant="pa21")
+    assert ref["r_outer_km"] == pytest.approx(float(pa21["r_outer_km"][0]))
+    assert ref["r34_km"] == pytest.approx(float(pa21["r34_km"][0]))
+    assert ref["r_outer_km"] > ref["r34_km"] > ref["rmax_km"] > 0.0
+
+
+def test_w06_tail_cut_at_wind_speed() -> None:
+    r = np.linspace(0.0, 900.0, 9001)
+    kw = dict(vmax_kt=90.0, lat=20.0, r34_mean_km=200.0, h34=0.2)
+    full = compute_w06_wind_hazard_with_tail(r, 200.0, 800.0, **kw)
+    cut = compute_w06_wind_hazard_with_tail(r, 200.0, 800.0, tail_end_wind_kt=17.0, **kw)
+    outside = r > 200.0
+    assert (cut["H_W"][outside & (cut["wind_kt"] <= 17.0)] < 1e-12).all()
+    np.testing.assert_allclose(cut["H_W"][~outside], full["H_W"][~outside])
+    assert (cut["H_W"] <= full["H_W"] + 1e-12).all()
+    with pytest.raises(ValueError):
+        compute_w06_wind_hazard_with_tail(r, 200.0, 800.0, tail_end_wind_kt=40.0, **kw)
+
+
+# ------------------------------------------------------------------ compute_itchi_snapshot_v02
+
+
+def test_v02_reproduces_the_v02_study_setting() -> None:
+    # ROCLOUD smaller than R_W06 in every quadrant -> R_attr = R_W06 = end of
+    # the wind tail, the setting of notebooks 05-08 (attribution = R_W06)
+    lon, lat = _grid()
+    p6, r24, a72 = _fields(lon.shape)
+    r_w06 = _r_w06()
+    res = _v02(p6, r24, a72, lon, lat, rocloud_by_quadrant={q: 100.0 for q in QUADS},
+               run_quality_control=True)
+    assert set(res["R_attr_status"].values()) == {"w06_floor"}
+    assert res["R_attr_by_quadrant"] == pytest.approx({q: r_w06 for q in QUADS})
+
+    hp = compute_precipitation_matrix_hazard(
+        p6, Q6, {"R24": r24, "A72": a72}, {"R24": Q24, "A72": Q72}
+    )
+    ref = compute_itchi_snapshot_from_grid(
+        p6, None, None, None, lon=lon, lat=lat,
+        rocloud_by_quadrant={q: r_w06 for q in QUADS}, rocloud_unit="km",
+        precipitation_hazard=hp, wind_model="w06_tail", **CASE,
+    )
+    for key in ("M_direct", "M_indirect", "M_exterior"):
+        np.testing.assert_array_equal(res[key], ref[key])
+    for key in ("H_P", "H_W", "H_Wind", "H_dir", "H_ind", "ITCHI"):
+        np.testing.assert_allclose(res[key], ref[key], atol=1e-12)
+    assert res["itchi_formulation"] == "v0.2"
+
+
+def test_v02_wind_ends_at_r_w06_and_rain_extends_to_rocloud() -> None:
+    lon, lat = _grid()
+    p6, r24, a72 = _fields(lon.shape)
+    r_w06 = _r_w06()
+    roc = {"RNE": r_w06 + 200.0, "RSE": None, "RSW": 0.0, "RNW": r_w06 - 100.0}
+    res = _v02(p6, r24, a72, lon, lat, rocloud_by_quadrant=roc, run_quality_control=True)
+
+    assert res["R_attr_status"] == {
+        "RNE": "rocloud", "RSE": "w06_missing_rocloud",
+        "RSW": "w06_missing_rocloud", "RNW": "w06_floor",
+    }
+    assert res["R_attr_by_quadrant"]["RNE"] == pytest.approx(r_w06 + 200.0)
+
+    beyond = res["radius_km"] >= res["R_W06_q"]
+    assert (res["H_W"][beyond] < 1e-12).all()
+    band = res["M_indirect"] & beyond          # indirect region beyond R_W06 (RNE)
+    assert band.any()
+    np.testing.assert_allclose(res["H_ind"][band], res["H_Pind"][band])
+    assert (res["ITCHI"][res["M_exterior"]] == 0.0).all()
+
